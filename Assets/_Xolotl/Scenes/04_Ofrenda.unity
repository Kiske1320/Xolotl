  photoCountText: {fileID: 724932507}
  endPanel: {fileID: 1450037678}
  lines:
  - Las veladoras se avivan.
  - "El pan de muerto todav\xEDa est\xE1 tibio."
  - "La familia no puede verla, pero sabe que lleg\xF3."
  - Aurora baja de tu lomo y acaricia tu cabeza.
  endingAll: "\xABMe trajiste todos mis recuerdos. Ahora s\xED estoy completa.\xBB"
  endingSome: "\xABAlgunos recuerdos se quedaron en el camino, pero mi familia guarda
    el resto.\xBB"
  endingFew: "\xABYa casi no recuerdo nada... pero mientras ellos me recuerden, aqu\xED
    estar\xE9.\xBB"
  totalPhotos: 9
  somePhotosThreshold: 4
  startDelay: 1.5
  charsPerSecond: 28
  lineHold: 2.2
  titleScene: 00_Titulo
